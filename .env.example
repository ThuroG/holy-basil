# Holy Basil server settings. Set these as environment variables before starting the server.

# Crew PIN for /admin (at least 4 characters). Without it a random PIN is printed at each start.
CREW_PIN=

# 1 = TWINT and card run against the built-in TEST provider (no money moves). Leave empty for cash only.
DEMO_PAYMENTS=

# Secret for the payment webhook signature (at least 16 characters). Without it a random one is used per start.
PAYMENT_WEBHOOK_SECRET=

# 1 = read the client address from X-Forwarded-For. Set only behind your own reverse proxy.
TRUST_PROXY=

# Rate limits per client address (defaults: 30 orders per 5 minutes, 5 form posts per 10 minutes).
RATE_LIMIT_ORDERS=
RATE_LIMIT_FORMS=

# Public address of the site, used for the QR code (e.g. https://holybasil.ch). Default: the request host.
PUBLIC_BASE_URL=

# Port (default 3000) and data folder (default ./data)
PORT=3000
HB_DATA_DIR=

# Holy Basil server settings. Set these as environment variables before starting the server.

# Crew PIN for /admin (at least 4 characters). Without it a random PIN is printed at each start.
CREW_PIN=

# 1 = TWINT and card appear in the order app as a SIMULATION (no money moves). Leave empty for cash only.
DEMO_PAYMENTS=

# Public address of the site, used for the QR code (e.g. https://holybasil.ch). Default: the request host.
PUBLIC_BASE_URL=

# Port (default 3000) and data folder (default ./data)
PORT=3000
HB_DATA_DIR=
